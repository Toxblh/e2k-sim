diff --git a/target/e2k/helper_int.c b/target/e2k/helper_int.c
index ff474a0..f2a8903 100644
--- a/target/e2k/helper_int.c
+++ b/target/e2k/helper_int.c
@@ -436,3 +436,25 @@ uint64_t HELPER(clmulh)(uint64_t s1, uint64_t s2)
 
     return r;
 }
+
+/* sim: adds_fw/subs_fw write an x86 EFLAGS image (checked on Elbrus-8SV: 5+7 -> 0x4, 0x7fffffff+1 -> 0x894, 0xffffffff+1 -> 0x55) */
+static uint32_t sim_x86_flags(uint32_t a, uint32_t b, uint32_t r, uint32_t cf, uint32_t of)
+{
+    uint32_t f = cf ? 1 : 0;
+    f |= (__builtin_popcount(r & 0xff) & 1) ? 0 : 0x4;
+    f |= (a ^ b ^ r) & 0x10;
+    f |= r == 0 ? 0x40 : 0;
+    f |= (r >> 31) ? 0x80 : 0;
+    f |= of ? 0x800 : 0;
+    return f;
+}
+uint32_t HELPER(addw_fw)(uint32_t a, uint32_t b)
+{
+    uint32_t r = a + b;
+    return sim_x86_flags(a, b, r, r < a, ((a ^ r) & (b ^ r)) >> 31);
+}
+uint32_t HELPER(subw_fw)(uint32_t a, uint32_t b)
+{
+    uint32_t r = a - b;
+    return sim_x86_flags(a, b, r, a < b, ((a ^ b) & (a ^ r)) >> 31);
+}
